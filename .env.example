# ==============================================================================
# HYBRID HOTEL MARKETPLACE, FOOD ORDERING & CENTRALIZED DELIVERY PLATFORM
# Environment Variables Configuration
# ==============================================================================

# NEXT.JS APPLICATION
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_TIMEZONE=Asia/Kolkata
NEXT_PUBLIC_DEFAULT_CURRENCY=INR

# SUPABASE POSTGRESQL & REALTIME
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# RAZORPAY PAYMENT GATEWAY (INDIA)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecretHere

# MAPS & GEOCODING
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here

# SMS / OTP PROVIDER (MSG91 / Fast2SMS)
SMS_API_KEY=your_sms_gateway_key
